import "core/bash_lex.oo";
import "core/bash_parse.oo";
import "core/bash_audit.oo";
import "core/bash_transpile.oo";

pub fn core_subsystem_version() -> String {
    return "0.2.0";
}

pub fn core_subsystem_description() -> String {
    return "oobash pure openOODA shell compiler and security auditor subsystem";
}
