// # oobash Shell Tokenizer
//
// Logline: Lexical analyzer partitioning POSIX shell scripts into classified tokens.
//
// Setup: Pure string scanning isolating operators, literals, pipes, redirects, and variables.
//
// Beats:
//   1. Identify operator sequences for pipes, logical conjunctions, and redirections.
//   2. Extract double and single quoted string literals preserving escape sequences.
//   3. Extract variable identifiers and command words.

pub type ShellToken = struct {
    kind: String,
    value: String
};

fn is_whitespace(c: String) -> Bool {
    return c == " " || c == "\t" || c == "\r";
}

fn is_operator_char(c: String) -> Bool {
    return c == "|" || c == "&" || c == ";" || c == ">" || c == "<" || c == "\n";
}

pub fn tokenize_script(script: String) -> List[ShellToken] {
    let mut tokens: List[ShellToken] = list_new();
    let n: Int = chars_len(script);
    let mut i: Int = 0;

    while i < n {
        let c: String = char_at(script, i);
        if is_whitespace(c) {
            i = i + 1;
        } else if c == "#" {
            while i < n && char_at(script, i) != "\n" {
                i = i + 1;
            }
        } else if c == "\n" {
            tokens = list_push(tokens, ShellToken { kind: "newline", value: "\n" });
            i = i + 1;
        } else if c == "|" {
            if i + 1 < n && char_at(script, i + 1) == "|" {
                tokens = list_push(tokens, ShellToken { kind: "or", value: "||" });
                i = i + 2;
            } else {
                tokens = list_push(tokens, ShellToken { kind: "pipe", value: "|" });
                i = i + 1;
            }
        } else if c == "&" {
            if i + 1 < n && char_at(script, i + 1) == "&" {
                tokens = list_push(tokens, ShellToken { kind: "and", value: "&&" });
                i = i + 2;
            } else {
                tokens = list_push(tokens, ShellToken { kind: "bg", value: "&" });
                i = i + 1;
            }
        } else if c == ";" {
            tokens = list_push(tokens, ShellToken { kind: "semi", value: ";" });
            i = i + 1;
        } else if c == ">" {
            if i + 1 < n && char_at(script, i + 1) == ">" {
                tokens = list_push(tokens, ShellToken { kind: "append", value: ">>" });
                i = i + 2;
            } else {
                tokens = list_push(tokens, ShellToken { kind: "redir_out", value: ">" });
                i = i + 1;
            }
        } else if c == "<" {
            tokens = list_push(tokens, ShellToken { kind: "redir_in", value: "<" });
            i = i + 1;
        } else if c == "\"" || c == "'" {
            let quote: String = c;
            let mut val: String = "";
            i = i + 1;
            while i < n && char_at(script, i) != quote {
                val = val + char_at(script, i);
                i = i + 1;
            }
            if i < n { i = i + 1; }
            tokens = list_push(tokens, ShellToken { kind: "string", value: val });
        } else {
            let mut word: String = "";
            while i < n && !is_whitespace(char_at(script, i)) && !is_operator_char(char_at(script, i)) && char_at(script, i) != "#" {
                word = word + char_at(script, i);
                i = i + 1;
            }
            tokens = list_push(tokens, ShellToken { kind: "word", value: word });
        }
    }

    return tokens;
}
