// # oobash Script Transpiler
//
// Logline: Generates capability-bounded openOODA source code from shell ASTs.
//
// Setup: Emits native .oo code with exact capability parameters and zero ambient authority.
//
// Beats:
//   1. Infer minimum capability tokens needed for the function signature.
//   2. Generate main entry point with strict type annotations.
//   3. Emit commands, arguments, and pipeline invocations.

import "core/bash_parse.oo";
import "core/bash_audit.oo";

pub fn transpile_to_openooda(script: ShellScript) -> String {
    let audit: BashAuditResult = audit_script(script);
    let mut code: String = "// Generated by oobash 0.2.0 (openOODA Sovereign Compiler)\n\n";

    code = code + "pub fn main(\n";
    if audit.need_fs_read {
        code = code + "    fs: &FsReadCap,\n";
    }
    if audit.need_fs_write {
        code = code + "    fs_out: &FsWriteCap,\n";
    }
    if audit.need_process {
        code = code + "    proc: &ProcessCap,\n";
    }
    if audit.need_env {
        code = code + "    env: &EnvCap,\n";
    }
    if audit.need_net {
        code = code + "    net: &NetCap,\n";
    }
    code = code + "    args: List[String]\n) -> Result[Int, String] {\n";

    let n_pipes: Int = list_len(script.pipelines);
    let mut i: Int = 0;
    while i < n_pipes {
        let p: ShellPipeline = list_get(script.pipelines, i);
        let n_cmds: Int = list_len(p.commands);
        let mut j: Int = 0;
        while j < n_cmds {
            let cmd: ShellCommand = list_get(p.commands, j);
            if cmd.name == "echo" {
                let mut msg: String = "";
                let n_args: Int = list_len(cmd.args);
                let mut k: Int = 0;
                while k < n_args {
                    if k > 0 { msg = msg + " "; }
                    msg = msg + list_get(cmd.args, k);
                    k = k + 1;
                }
                code = code + "    println(\"" + msg + "\");\n";
            } else {
                code = code + "    // Exec: " + cmd.name + "\n";
                code = code + "    let mut c_args: List[String] = list_new();\n";
                let n_args: Int = list_len(cmd.args);
                let mut k: Int = 0;
                while k < n_args {
                    code = code + "    c_args = list_push(c_args, \"" + list_get(cmd.args, k) + "\");\n";
                    k = k + 1;
                }
                code = code + "    // process_exec(proc, \"" + cmd.name + "\", c_args);\n";
            }
            j = j + 1;
        }
        i = i + 1;
    }

    code = code + "    return Ok(0);\n}\n";
    return code;
}
